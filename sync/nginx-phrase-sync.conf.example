# Include inside the existing TLS server; adjust the bridge address, certificate
# path and certificate name for the deployed phrase-sync backend.
location = /v1/sync {
    access_log off;
    client_max_body_size 16m;
    proxy_pass https://172.19.0.1:8444/v1/sync;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/nginx/certs/deployed/phrase-sync.crt;
    proxy_ssl_name 64.56.71.36;
    proxy_set_header Host 64.56.71.36;
    proxy_buffering off;
    # The socket-activated backend serializes requests. A global 3s handshake
    # budget can reject the second hourly client while the first is processing.
    proxy_connect_timeout 15s;
    proxy_read_timeout 30s;
}
