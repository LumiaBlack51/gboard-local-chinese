  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="local.gboard.DICTIONARY_SYNC" />
  <queries><package android:name="com.localx.android.inputmethod.latin" /><package android:name="local.gboard.voice" /><package android:name="local.gboard.proofread" /></queries>
  <application android:label="Gboard 增强更新" android:allowBackup="false" android:debuggable="false" android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name=".PhraseSyncSettings" android:exported="false" />
    <activity android:name=".UpdateActivity" android:exported="true" />
    <service android:name=".PhraseSync" android:process=":dictionary_sync" android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE" />
    <receiver android:name=".PhraseSyncReceiver" android:process=":dictionary_sync" android:exported="false">
      <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
    </receiver>
    <receiver android:name=".InstallReceiver" android:exported="false" />
  </application>
</manifest>
